{
  // Global settings
  "workbench.colorTheme": "Dark Modern",
  "editor.bracketPairColorization.enabled": true,
  "editor.minimap.enabled": false,

  // Python language analysis settings
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoFormatStrings": true,
  "python.analysis.inlayHints.functionReturnTypes": true,

  // Per-language Python formatting & linting
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // YAML schema associations for organization and explicit-account configs
  "yaml.schemas": {
    "src/anvil/schemas/orgs.schema.v1.json": [
      "yaml/*.yaml",
      "yaml/*.yml",
      "examples/0*.yaml",
      "examples/0*.yml",
      "examples/1[0-2]-*.yaml",
      "examples/1[0-2]-*.yml"
    ],
    "src/anvil/schemas/accounts.schema.v1.json": [
      "examples/13-*.yaml",
      "examples/13-*.yml"
    ]
  },

  "yaml.validate": true,
  "yaml.hover": true,
  "yaml.completion": true

}
