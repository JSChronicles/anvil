	"Advanced General Logging Function": {
		"prefix": "function-advanced-error/logger",
		"body": [
			"import argparse",
			"import json",
			"import logging",
			"from datetime import datetime, timedelta",
			"from zoneinfo import ZoneInfo",
			"",
			"import boto3",
			"",
			"# Constants",
			"TIMEZONE = ZoneInfo(\"America/Chicago\")",
			"",
			"__LOGGER__ = logging.getLogger(__name__)",
			"",
			"logging.basicConfig(",
			"    format=\"%(levelname)-8s [%(filename)s:%(module)s:%(funcName)s:%(lineno)d] %(message)s\"",
			")",
			"",
			"",
			"def get_phd_events(",
			"    event_type_code: list[str], days: int, region: list[str], profile: str",
			") -> dict[str, dict[str, list]]:",
			"    \"\"\"",
			"    Fetch AWS Personal Health Dashboard (PHD) events based on the specified filters.",
			"",
			"    Parameters:",
			"    -----------",
			"    event_type_code : list[str], optional",
			"        A list of one or more event type codes to filter the AWS Health events. If not provided,",
			"        all event types will be retrieved.",
			"",
			"    days : int, optional",
			"        The number of days back from the current date to filter events based on the last update time.",
			"        The default is 30 days. If set to None, no time filtering is applied.",
			"",
			"    region : list[str]",
			"        A list of AWS region names (e.g., [\"us-east-1\", \"us-west-2\"]) to filter events by region.",
			"        The function will retrieve events related to these regions.",
			"",
			"    profile : str, optional",
			"        The name of the AWS profile to use for authentication. If not provided, the default profile",
			"        will be used.",
			"",
			"    Returns:",
			"    --------",
			"    dict[str, dict[str, list]]",
			"        A dictionary where the key is the region name and the value is another dictionary containing",
			"        an \"events\" key that holds a list of event dictionaries.",
			"",
			"    Description:",
			"    ------------",
			"    This function interacts with the AWS Personal Health Dashboard (PHD) API to fetch events related to AWS",
			"    services based on filters such as event type, region, and time range. The function builds a filter",
			"    dynamically and retrieves events using the `describe_events` API from the AWS Health service.",
			"",
			"    Example:",
			"    --------",
			"    events = get_phd_events(region=[\"us-east-1\"], profile=\"my_aws_profile\")",
			"    events = get_phd_events(region=[\"us-east-1\", \"us-west-2\"], profile=\"my_aws_profile\")",
			"    events = get_phd_events(days=7, region=[\"us-east-1\", \"us-west-2\"], profile=\"my_aws_profile\")",
			"    events = get_phd_events(event_type_code=[\"AWS_ECS_TASK_PATCHING_RETIREMENT\"], days=7, region=[\"us-east-1\"], profile=\"my_aws_profile\")",
			"    events = get_phd_events(event_type_code=[\"AWS_ECS_TASK_PATCHING_RETIREMENT\", \"AWS_EC2_OPERATIONAL_ISSUE\"], days=7, region=[\"us-east-1\", \"us-west-2\"], profile=\"my_aws_profile\")",
			"",
			"    \"\"\"",
			"",
			"    try:",
			"        __LOGGER__.debug(\"Creating session\")",
			"        session = boto3.Session(profile_name=profile)",
			"",
			"        __LOGGER__.debug(\"Initialize a boto3 client for AWS Health\")",
			"        client = session.client(\"health\", region_name=\"us-east-1\")",
			"",
			"        __LOGGER__.debug(\"Initialize describe_events filter\")",
			"        describe_events_filter: dict[str, list | str] = {",
			"            \"regions\": region,",
			"            \"eventStatusCodes\": [\"open\", \"upcoming\", \"closed\"],",
			"            \"eventTypeCategories\": [\"issue\", \"scheduledChange\"],",
			"        }",
			"",
			"        if days:",
			"            # Calculate the start and end times based on the number of days",
			"            end_time = datetime.now(TIMEZONE)",
			"            start_time = end_time - timedelta(days=days)",
			"",
			"            __LOGGER__.debug(",
			"                f\"Filtering by lastUpdatedTimes from {start_time} to {end_time}\"",
			"            )",
			"            describe_events_filter[\"lastUpdatedTimes\"] = [",
			"                {\"from\": start_time.isoformat(), \"to\": end_time.isoformat()}",
			"            ]",
			"",
			"        if event_type_code:",
			"            __LOGGER__.debug(f\"Filtering by eventTypeCodes: {event_type_code}\")",
			"            describe_events_filter[\"eventTypeCodes\"] = event_type_code",
			"",
			"        # Get all events in the specified time range and event type code",
			"        __LOGGER__.info(\"Gathering filtered AWS PHD events\")",
			"        response = client.describe_events(filter=describe_events_filter)",
			"",
			"        __LOGGER__.debug(\"Initialize stored_events array\")",
			"        stored_events = {}",
			"",
			"        def format_time(time: datetime):",
			"            return time.astimezone(TIMEZONE).strftime(\"%Y-%m-%d %H:%M:%S %Z\")",
			"",
			"        for event in response[\"events\"]:",
			"            region_name = event.get(\"region\")",
			"",
			"            # fmt: off",
			"            phd_event = {",
			"                \"event_type_code\": event.get(\"eventTypeCode\"),",
			"                \"event_type_category\": event.get(\"eventTypeCategory\"),",
			"                \"region\": event.get(\"region\"),",
			"                \"start_time\": format_time(event[\"startTime\"]),",
			"                \"end_time\": event.get(\"endTime\") if not event.get(\"endTime\") else format_time(event[\"endTime\"]),",
			"                \"last_update_time\": format_time(event[\"lastUpdatedTime\"]),",
			"            }",
			"            # fmt: on",
			"",
			"            if region_name not in stored_events:",
			"                stored_events[region_name] = {\"events\": []}",
			"",
			"            stored_events[region_name][\"events\"].append(phd_event)",
			"",
			"        return stored_events",
			"",
			"    except Exception as e:",
			"        __LOGGER__.error(f\"Error fetching AWS PHD events: {e}\")",
			"        raise",
			"",
			"",
			"if __name__ == \"__main__\":",
			"    parser = argparse.ArgumentParser(description=\"Gather AWS PHD Events\")",
			"    parser.add_argument(",
			"        \"-etc\",",
			"        \"--event-type-code\",",
			"        nargs=\"+\",",
			"        type=str,",
			"        required=False,",
			"        help=\"Enter one or more event type codes for health describe_events\",",
			"    )",
			"    parser.add_argument(",
			"        \"-d\",",
			"        \"--days\",",
			"        required=False,",
			"        type=int,",
			"        help=\"Number of days back to start\",",
			"        default=1,",
			"    )",
			"    parser.add_argument(",
			"        \"--log-level\",",
			"        default=\"INFO\",",
			"        choices=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],",
			"        help=\"Logging level (default: INFO)\",",
			"    )",
			"    parser.add_argument(",
			"        \"-r\",",
			"        \"--region\",",
			"        nargs=\"+\",",
			"        type=str,",
			"        required=True,",
			"        help=\"One or more AWS regions\",",
			"    )",
			"    parser.add_argument(",
			"        \"-p\", \"--profile\", type=str, required=False, help=\"AWS profile name\"",
			"    )",
			"",
			"    args = parser.parse_args()",
			"",
			"    __LOGGER__.setLevel(getattr(logging, args.log_level))",
			"",
			"    phd_event_info = get_phd_events(",
			"        args.event_type_code, args.days, args.region, args.profile",
			"    )",
			"",
			"    print(json.dumps(phd_event_info, indent=4))"
		],
		"description": "Advanced General Logging Function"
		}
}
