{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.local/schemas/common.schema.v1.json",
  "title": "Anvil Common Schema Definitions v1",
  "description": "Shared schema definitions for Anvil configuration files.",
  "$defs": {
    "taskEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Task name (must match task module filename)."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "List of task names that must complete before this task runs."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, task failure does not fail the account or block dependent tasks."
        }
      }
    },
    "postRunEntry": {
      "type": "object",
      "required": [
        "processor"
      ],
      "additionalProperties": false,
      "properties": {
        "processor": {
          "type": "string",
          "minLength": 1,
          "description": "Registered post-run processor name."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Optional processor-owned output destination."
        },
        "metadata": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "Free-form processor-specific configuration."
        },
        "run_on_failure": {
          "type": "boolean",
          "default": false,
          "description": "If true, run this processor even when the target has failures."
        }
      }
    },
    "profile": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Provider profile for the source authentication context when used under provider.options."
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "default": [
        "us-east-1"
      ],
      "description": "Provider regions/locations for task execution. AWS organization configs also support the 'all' selector and glob selectors.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "role_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional AWS IAM role name to assume in target accounts when used under provider.options. AWS organizations default to OrganizationAccountAccessRole at runtime; AWS accounts run directly when omitted."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "description": "Tasks to execute for this target group.",
      "items": {
        "$ref": "#/$defs/taskEntry"
      },
      "default": [
        {
          "name": "noop"
        }
      ]
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum number of concurrent execution target workers."
    },
    "max_parallel_regions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "Maximum number of concurrent regions/locations to execute within one resolved target."
    },
    "max_parallel_targets": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Maximum number of configured target entries to execute concurrently within one YAML run."
    },
    "fail_fast": {
      "type": "boolean",
      "default": false,
      "description": "Stop processing remaining work for this target group after the first unsuccessful target result."
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Run in dry-run mode without making changes."
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "description": "Free-form metadata for execution context."
    },
    "provider": {
      "type": "string",
      "enum": [
        "aws",
        "azure",
        "gcp",
        "github"
      ],
      "default": "aws",
      "description": "Cloud provider for this target. Omitted legacy configs default to aws."
    },
    "mode": {
      "type": "string",
      "enum": [
        "organization",
        "accounts",
        "tenant",
        "subscriptions",
        "projects",
        "organizations",
        "repositories"
      ],
      "description": "Provider-specific target mode. Omitted legacy configs default from the top-level branch and provider."
    },
    "awsProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "role_name": {
          "$ref": "#/$defs/role_name"
        }
      }
    },
    "azureProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "client_secret": {
          "type": "string",
          "minLength": 1
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gcpProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credentials_path": {
          "type": "string",
          "minLength": 1
        },
        "organization_id": {
          "type": "string",
          "minLength": 1
        },
        "quota_project_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "githubProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "profile",
              "api_url"
            ]
          }
        },
        {
          "not": {
            "required": [
              "profile",
              "api_version"
            ]
          }
        },
        {
          "not": {
            "required": [
              "profile",
              "token_env"
            ]
          }
        },
        {
          "not": {
            "required": [
              "profile",
              "app_id"
            ]
          }
        },
        {
          "not": {
            "required": [
              "profile",
              "private_key_env"
            ]
          }
        },
        {
          "not": {
            "required": [
              "profile",
              "private_key_path"
            ]
          }
        }
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "api_url": {
          "type": "string",
          "minLength": 1
        },
        "api_version": {
          "type": "string",
          "minLength": 1
        },
        "token_env": {
          "type": "string",
          "minLength": 1
        },
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "private_key_env": {
          "type": "string",
          "minLength": 1
        },
        "private_key_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "post_run": {
      "type": "array",
      "minItems": 1,
      "description": "Post-run processors executed after this target completes. By default processors run only for successful targets; set run_on_failure on an entry to also run it for failed targets.",
      "items": {
        "$ref": "#/$defs/postRunEntry"
      }
    },
    "accountIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{12}$"
      },
      "description": "AWS account ID list."
    },
    "targetIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Provider-specific execution target ID list. AWS uses account IDs, Azure uses subscription IDs, GCP uses project IDs, and GitHub uses organization logins or owner/repo names."
    },
    "githubOrganizationList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      },
      "uniqueItems": true,
      "description": "GitHub owner login list. Values may be organization or user logins."
    },
    "githubRepositoryList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[^/\\s]+$"
      },
      "uniqueItems": true,
      "description": "GitHub owner/repo repository list."
    },
    "baseTargetProperties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Logical name of this execution target group."
      },
      "regions": {
        "$ref": "#/$defs/regions"
      },
      "tasks": {
        "$ref": "#/$defs/tasks"
      },
      "max_workers": {
        "$ref": "#/$defs/max_workers"
      },
      "max_parallel_regions": {
        "$ref": "#/$defs/max_parallel_regions"
      },
      "fail_fast": {
        "$ref": "#/$defs/fail_fast"
      },
      "dry_run": {
        "$ref": "#/$defs/dry_run"
      },
      "metadata": {
        "$ref": "#/$defs/metadata"
      },
      "post_run": {
        "$ref": "#/$defs/post_run"
      }
    }
  }
}
