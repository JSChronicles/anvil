{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.local/schemas/common.schema.v1.json",
  "title": "Anvil Common Schema Definitions v1",
  "description": "Shared schema definitions for Anvil configuration files.",
  "$defs": {
    "taskEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Task name (must match task module filename)."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "List of task names that must complete before this task runs."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, task failure does not fail the account or block dependent tasks."
        }
      }
    },
    "postRunEntry": {
      "type": "object",
      "required": [
        "processor"
      ],
      "additionalProperties": false,
      "properties": {
        "processor": {
          "type": "string",
          "minLength": 1,
          "description": "Registered post-run processor name."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Optional processor-owned output destination."
        },
        "metadata": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "Free-form processor-specific configuration."
        },
        "run_on_failure": {
          "type": "boolean",
          "default": false,
          "description": "If true, run this processor even when the target has failures."
        }
      }
    },
    "profile": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "AWS CLI profile for the source authentication context."
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "default": [
        "us-east-1"
      ],
      "description": "Provider regions/locations for task execution. AWS organization configs also support the 'all' selector and glob selectors.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "role_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional AWS IAM role name to assume in target accounts. AWS organizations default to OrganizationAccountAccessRole at runtime; AWS accounts run directly when omitted."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "description": "Tasks to execute for this target group.",
      "items": {
        "$ref": "#/$defs/taskEntry"
      },
      "default": [
        {
          "name": "noop"
        }
      ]
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum number of concurrent execution target workers."
    },
    "max_parallel_regions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "Maximum number of concurrent regions/locations to execute within one resolved target."
    },
    "max_parallel_targets": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Maximum number of configured target entries to execute concurrently within one YAML run."
    },
    "fail_fast": {
      "type": "boolean",
      "default": false,
      "description": "Stop processing remaining work for this target group after the first unsuccessful target result."
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Run in dry-run mode without making changes."
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "description": "Free-form metadata for execution context."
    },
    "provider": {
      "type": "string",
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "default": "aws",
      "description": "Cloud provider for this target. Omitted legacy configs default to aws."
    },
    "mode": {
      "type": "string",
      "enum": [
        "organization",
        "accounts",
        "subscriptions",
        "projects"
      ],
      "description": "Provider-specific target mode. Omitted legacy configs default from the top-level branch and provider."
    },
    "provider_options": {
      "type": "object",
      "default": {},
      "description": "Provider-specific target options. Legacy AWS profile and role_name fields remain supported at top level; matching provider_options aliases are accepted for compatibility.",
      "additionalProperties": true
    },
    "awsProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "role_name": {
          "$ref": "#/$defs/role_name"
        }
      }
    },
    "azureProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gcpProviderOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credentials_path": {
          "type": "string",
          "minLength": 1
        },
        "quota_project_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "post_run": {
      "type": "array",
      "minItems": 1,
      "description": "Post-run processors executed after this target completes. By default processors run only for successful targets; set run_on_failure on an entry to also run it for failed targets.",
      "items": {
        "$ref": "#/$defs/postRunEntry"
      }
    },
    "accountIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{12}$"
      },
      "description": "AWS account ID list."
    },
    "targetIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Provider-specific execution target ID list. AWS uses account IDs, Azure uses subscription IDs, and GCP uses project IDs."
    },
    "baseTargetProperties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Logical name of this execution target group."
      },
      "profile": {
        "$ref": "#/$defs/profile"
      },
      "regions": {
        "$ref": "#/$defs/regions"
      },
      "role_name": {
        "$ref": "#/$defs/role_name"
      },
      "tasks": {
        "$ref": "#/$defs/tasks"
      },
      "max_workers": {
        "$ref": "#/$defs/max_workers"
      },
      "max_parallel_regions": {
        "$ref": "#/$defs/max_parallel_regions"
      },
      "fail_fast": {
        "$ref": "#/$defs/fail_fast"
      },
      "dry_run": {
        "$ref": "#/$defs/dry_run"
      },
      "metadata": {
        "$ref": "#/$defs/metadata"
      },
      "provider": {
        "$ref": "#/$defs/provider"
      },
      "mode": {
        "$ref": "#/$defs/mode"
      },
      "provider_options": {
        "$ref": "#/$defs/provider_options"
      },
      "post_run": {
        "$ref": "#/$defs/post_run"
      }
    }
  }
}
