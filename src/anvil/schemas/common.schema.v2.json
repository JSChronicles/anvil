{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.local/schemas/common.schema.v2.json",
  "title": "Anvil Common Schema Definitions v2",
  "description": "Shared schema definitions for Anvil configuration files.",
  "$defs": {
    "taskEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Task name (must match the discovered task component name)."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "List of task names that must complete before this task runs."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, task failure does not fail the account or block dependent tasks."
        }
      }
    },
    "postRunEntry": {
      "type": "object",
      "required": [
        "processor"
      ],
      "additionalProperties": false,
      "properties": {
        "processor": {
          "type": "string",
          "minLength": 1,
          "description": "Registered post-run processor name."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Optional processor-owned output destination."
        },
        "metadata": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "Free-form processor-specific configuration."
        },
        "run_on_failure": {
          "type": "boolean",
          "default": false,
          "description": "If true, run this processor even when the target has failures."
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Provider regions or locations for task execution.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "description": "Tasks to execute for this target group.",
      "items": {
        "$ref": "#/$defs/taskEntry"
      },
      "default": [
        {
          "name": "noop"
        }
      ]
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum number of concurrent execution target workers."
    },
    "max_parallel_regions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "Maximum number of concurrent regions/locations to execute within one resolved target."
    },
    "max_parallel_targets": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Maximum number of configured target entries to execute concurrently within one YAML run."
    },
    "fail_fast": {
      "type": "boolean",
      "default": false,
      "description": "Stop processing remaining work for this target group after the first unsuccessful target result."
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Run in dry-run mode without making changes."
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "description": "Free-form metadata for execution context."
    },
    "post_run": {
      "type": "array",
      "minItems": 1,
      "description": "Post-run processors executed after this target completes. By default processors run only for successful targets; set run_on_failure on an entry to also run it for failed targets.",
      "items": {
        "$ref": "#/$defs/postRunEntry"
      }
    },
    "targetIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Provider-owned execution target ID list."
    },
    "baseTargetProperties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Logical name of this execution target group."
      },
      "regions": {
        "$ref": "#/$defs/regions"
      },
      "tasks": {
        "$ref": "#/$defs/tasks"
      },
      "max_workers": {
        "$ref": "#/$defs/max_workers"
      },
      "max_parallel_regions": {
        "$ref": "#/$defs/max_parallel_regions"
      },
      "fail_fast": {
        "$ref": "#/$defs/fail_fast"
      },
      "dry_run": {
        "$ref": "#/$defs/dry_run"
      },
      "metadata": {
        "$ref": "#/$defs/metadata"
      },
      "post_run": {
        "$ref": "#/$defs/post_run"
      }
    }
  }
}
