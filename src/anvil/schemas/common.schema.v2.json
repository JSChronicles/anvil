{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.local/schemas/common.schema.v2.json",
  "title": "Anvil Common Schema Definitions v2",
  "description": "Shared schema definitions for Anvil configuration files.",
  "$defs": {
    "taskEntry": {
      "type": "object",
      "description": "One configured invocation of a discovered Python task component.",
      "examples": [
        {
          "id": "detach_guardrails",
          "name": "reconcile_config_guardrails",
          "metadata": {
            "attachment_state": "absent"
          }
        }
      ],
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique invocation ID for this configured task. When omitted, the discovered component name is used.",
          "examples": [
            "detach_guardrails"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Discovered Python task component name.",
          "examples": [
            "reconcile_config_guardrails"
          ]
        },
        "metadata": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "Static operator-configured context merged over target metadata for this invocation.",
          "examples": [
            {
              "attachment_state": "absent"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Effective task invocation ID that must reach a terminal state first.",
            "examples": [
              "detach_guardrails"
            ]
          },
          "uniqueItems": true,
          "description": "Effective task invocation IDs that control ordering, eligibility, and dependency-data availability.",
          "examples": [
            [
              "detach_guardrails",
              "cleanup_config"
            ]
          ]
        },
        "always_run": {
          "type": "boolean",
          "default": false,
          "description": "If true, run after every dependency reaches a terminal state even when a dependency was unsuccessful.",
          "examples": [
            true
          ]
        },
        "dependency_data": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "description": "Non-empty local input name chosen by the consuming task.",
            "examples": [
              "attachments"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependencyDataReference"
          },
          "description": "Runtime inputs selected from directly declared dependency TaskResults.",
          "examples": [
            {
              "attachments": {
                "task_id": "detach_guardrails",
                "path": "result.attachments"
              }
            }
          ]
        }
      }
    },
    "dependencyDataReference": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "additionalProperties": false,
      "description": "Selection of a complete dependency TaskResult or one readable dotted path within it.",
      "examples": [
        {
          "task_id": "detach_guardrails",
          "path": "result.attachments"
        }
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "description": "Effective ID of a task also listed directly in the consumer's depends_on.",
          "examples": [
            "detach_guardrails"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:result(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|status|error|actions)$",
          "description": "Optional dotted selection: result, nested result fields, status, error, or actions. List indexing is not supported.",
          "examples": [
            "result.attachments",
            "status"
          ]
        }
      }
    },
    "postRunEntry": {
      "type": "object",
      "required": [
        "processor"
      ],
      "additionalProperties": false,
      "properties": {
        "processor": {
          "type": "string",
          "minLength": 1,
          "description": "Registered post-run processor name."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Optional processor-owned output destination."
        },
        "metadata": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "Free-form processor-specific configuration."
        },
        "run_on_failure": {
          "type": "boolean",
          "default": false,
          "description": "If true, run this processor even when the target has failures."
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Provider regions or locations for task execution.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "description": "Tasks to execute for this target group.",
      "items": {
        "$ref": "#/$defs/taskEntry"
      },
      "default": [
        {
          "name": "noop"
        }
      ]
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum number of concurrent execution target workers."
    },
    "max_parallel_regions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "Maximum number of concurrent regions/locations to execute within one resolved target."
    },
    "max_parallel_targets": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Maximum number of configured target entries to execute concurrently within one YAML run."
    },
    "fail_fast": {
      "type": "boolean",
      "default": false,
      "description": "Stop processing remaining work for this target group after the first unsuccessful target result."
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Run in dry-run mode without making changes."
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "description": "Free-form metadata for execution context."
    },
    "post_run": {
      "type": "array",
      "minItems": 1,
      "description": "Post-run processors executed after this target completes. By default processors run only for successful targets; set run_on_failure on an entry to also run it for failed targets.",
      "items": {
        "$ref": "#/$defs/postRunEntry"
      }
    },
    "targetIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Provider-owned execution target IDs or filter keywords."
    },
    "baseTargetProperties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Logical name of this execution target group."
      },
      "regions": {
        "$ref": "#/$defs/regions"
      },
      "tasks": {
        "$ref": "#/$defs/tasks"
      },
      "max_workers": {
        "$ref": "#/$defs/max_workers"
      },
      "max_parallel_regions": {
        "$ref": "#/$defs/max_parallel_regions"
      },
      "fail_fast": {
        "$ref": "#/$defs/fail_fast"
      },
      "dry_run": {
        "$ref": "#/$defs/dry_run"
      },
      "metadata": {
        "$ref": "#/$defs/metadata"
      },
      "post_run": {
        "$ref": "#/$defs/post_run"
      }
    }
  }
}
