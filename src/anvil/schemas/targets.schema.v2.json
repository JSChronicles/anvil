{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.local/schemas/targets.schema.v2.json",
  "title": "Anvil Targets Configuration v2",
  "description": "Declarative provider-aware configuration for Anvil targets.",
  "type": "object",
  "required": [
    "schema_version",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Configuration schema version."
    },
    "max_parallel_targets": {
      "$ref": "common.schema.v2.json#/$defs/max_parallel_targets"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "description": "Provider targets to process.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "provider"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/name"
          },
          "provider": {
            "type": "object",
            "required": [
              "name",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Discovered provider component name."
              },
              "mode": {
                "type": "string",
                "minLength": 1,
                "description": "Provider-owned target mode."
              },
              "options": {
                "type": "object",
                "default": {},
                "additionalProperties": true,
                "description": "Provider-owned configuration options."
              }
            }
          },
          "regions": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/regions"
          },
          "tasks": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/tasks"
          },
          "max_workers": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/max_workers"
          },
          "max_parallel_regions": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/max_parallel_regions"
          },
          "fail_fast": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/fail_fast"
          },
          "dry_run": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/dry_run"
          },
          "metadata": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/metadata"
          },
          "post_run": {
            "$ref": "common.schema.v2.json#/$defs/baseTargetProperties/post_run"
          },
          "include": {
            "$ref": "common.schema.v2.json#/$defs/targetIdList"
          },
          "exclude": {
            "$ref": "common.schema.v2.json#/$defs/targetIdList"
          }
        },
        "not": {
          "required": [
            "include",
            "exclude"
          ]
        }
      }
    }
  }
}
