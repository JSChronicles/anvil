{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvil.local/schemas/accounts.schema.v1.json",
  "title": "Anvil Accounts Configuration",
  "description": "Declarative configuration for executing tasks against provider target lists.",
  "type": "object",
  "required": [
    "schema_version",
    "accounts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Configuration schema version."
    },
    "max_parallel_targets": {
      "$ref": "common.schema.v1.json#/$defs/max_parallel_targets"
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "description": "List of provider target groups to process. AWS requires explicit IDs; Azure subscriptions and GCP projects can be explicit or discovered when include is omitted.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/name"
          },
          "profile": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/profile"
          },
          "regions": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/regions",
            "description": "Explicit provider region/location names for target execution. Explicit target configs do not support 'all' or glob selectors.",
            "examples": [
              [
                "us-east-1"
              ],
              [
                "us-east-1",
                "us-west-2"
              ]
            ]
          },
          "role_name": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/role_name"
          },
          "provider": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/provider"
          },
          "mode": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/mode"
          },
          "provider_options": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/provider_options"
          },
          "tasks": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/tasks"
          },
          "max_workers": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/max_workers"
          },
          "max_parallel_regions": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/max_parallel_regions"
          },
          "fail_fast": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/fail_fast"
          },
          "dry_run": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/dry_run"
          },
          "metadata": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/metadata"
          },
          "post_run": {
            "$ref": "common.schema.v1.json#/$defs/baseTargetProperties/post_run"
          },
          "include": {
            "allOf": [
              {
                "$ref": "common.schema.v1.json#/$defs/targetIdList"
              }
            ],
            "description": "Explicit target IDs to execute against. Legacy/aws configs require AWS account IDs; azure uses subscription IDs; gcp uses project IDs. Mutually exclusive with exclude."
          },
          "exclude": {
            "allOf": [
              {
                "$ref": "common.schema.v1.json#/$defs/targetIdList"
              }
            ],
            "description": "Provider-specific target IDs to exclude from provider discovery. Currently supported for Azure subscription and GCP project discovery. Mutually exclusive with include."
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "provider"
                ]
              }
            },
            "then": {
              "required": [
                "include"
              ],
              "properties": {
                "include": {
                  "$ref": "common.schema.v1.json#/$defs/accountIdList"
                },
                "mode": {
                  "const": "accounts"
                },
                "provider_options": {
                  "$ref": "common.schema.v1.json#/$defs/awsProviderOptions"
                }
              },
              "not": {
                "required": [
                  "exclude"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "aws"
                }
              },
              "required": [
                "provider"
              ]
            },
            "then": {
              "required": [
                "include"
              ],
              "properties": {
                "include": {
                  "$ref": "common.schema.v1.json#/$defs/accountIdList"
                },
                "mode": {
                  "const": "accounts"
                },
                "provider_options": {
                  "$ref": "common.schema.v1.json#/$defs/awsProviderOptions"
                }
              },
              "not": {
                "required": [
                  "exclude"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "azure"
                }
              },
              "required": [
                "provider"
              ]
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "subscriptions"
                },
                "provider_options": {
                  "$ref": "common.schema.v1.json#/$defs/azureProviderOptions"
                }
              },
              "allOf": [
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "profile"
                        ]
                      },
                      {
                        "required": [
                          "role_name"
                        ]
                      }
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "include",
                      "exclude"
                    ]
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "gcp"
                }
              },
              "required": [
                "provider"
              ]
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "projects"
                },
                "provider_options": {
                  "$ref": "common.schema.v1.json#/$defs/gcpProviderOptions"
                }
              },
              "allOf": [
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "profile"
                        ]
                      },
                      {
                        "required": [
                          "role_name"
                        ]
                      }
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "include",
                      "exclude"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
